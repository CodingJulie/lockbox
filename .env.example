# Public site URL for SEO (must be valid https:// URL)
NEXT_PUBLIC_SITE_URL=https://lockbox-app.vercel.app

# Supabase — cloud storage. Production: create the project in an EU region
# (Frankfurt or Ireland) so data and backups stay under GDPR jurisdiction.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side pepper for Argon2id vault key hashes (openssl rand -base64 32)
VAULT_HASH_PEPPER=

# Optional dedicated salt for audit IP HMAC (falls back to VAULT_HASH_PEPPER)
AUDIT_IP_SALT=

# Upstash Redis — rate limits on Vercel (auth: 10 / IP / 15 min; vault create: 3 / IP / day)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
